@page
@model IndexModel
@{
    ViewData["Title"] = "Cat Fact App";
}

<div class="cat-page">
    <div class="cat-card">

        <div class="cat-header">
            <div class="cat-icon">🐱</div>
            <h1>Cat Fact App</h1>
            <p>
                Odkryj losowy fakt o kotach pobrany z zewnętrznego API.
            </p>
        </div>

        <form method="post" class="cat-form">
            <button type="submit" class="cat-button">
                Pobierz nowy fakt
            </button>
        </form>

        @if (Model.CatFact != null)
        {
            <div class="fact-box">
                <span class="fact-label">CAT FACT</span>

                <p class="fact-text">
                    @Model.CatFact.Fact
                </p>

                <div class="fact-footer">
                    Długość: <strong>@Model.CatFact.Length</strong> znaków
                </div>
            </div>
        }

        @if (Model.ErrorMessage != null)
        {
            <div class="error-box">
                @Model.ErrorMessage
            </div>
        }

    </div>
</div>